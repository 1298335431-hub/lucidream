DREAMCARD_ENV=development
DREAMCARD_IMAGE_QUOTA_TOTAL=8
DREAMCARD_MODEL_MODE=mock
DASHSCOPE_API_KEY=
DASHSCOPE_API_HOST=https://dashscope.aliyuncs.com
DREAMCARD_MODEL_TIMEOUT_SECONDS=20
DREAMCARD_QWEN_EXTRACT_MODEL=qwen3.8-flash
DREAMCARD_QWEN_INTERPRET_MODEL=qwen3.7-plus
DREAMCARD_EMBEDDING_MODEL=text-embedding-v4
DREAMCARD_EMBEDDING_DIMENSIONS=512
DREAMCARD_RERANK_MODEL=qwen3-rerank
DREAMCARD_WAN_IMAGE_MODEL=qwen-image-3.0-pro
DREAMCARD_DATABASE_PATH=./data/dreamcard.db
DREAMCARD_KNOWLEDGE_INDEX_PATH=./data/knowledge/dream_sources.sqlite3
# Local shadow retrieval reads confirmed symbols only and never changes user output.
DREAMCARD_ORIGINAL_KNOWLEDGE_SHADOW_MODE=local
DREAMCARD_ORIGINAL_KNOWLEDGE_CARDS_PATH=./data/knowledge/自建知识库/processed/cards.jsonl
DREAMCARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8443,http://127.0.0.1:8443
DREAMCARD_MAX_DREAM_CHARS=300
VITE_API_BASE_URL=/api/v1

# Cloud review is opt-in; disabled does NOT mean reviewed. Use a RAM identity.
DREAMCARD_MODERATION_MODE=disabled
# Set one supported region only after confirming the enabled service (e.g. cn-shanghai).
# DREAMCARD_MODERATION_REGION=cn-shanghai
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
DREAMCARD_MODERATION_TIMEOUT_SECONDS=5
