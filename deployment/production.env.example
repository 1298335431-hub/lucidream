# Only a template. Inject real secrets through the hosting platform, never bundle them.
# Do not copy ENV=prod / DATABASE_URL from the generic deployment handbook.
DREAMCARD_ENV=production
DREAMCARD_AUTH_ENABLED=true
DREAMCARD_IMAGE_QUOTA_TOTAL=8
DREAMCARD_MODEL_MODE=aliyun
DASHSCOPE_API_KEY=
# Must be an explicit path on storage whose persistence has been verified.
# Do not deploy with a temporary SQLite file and assume it is durable.
DREAMCARD_DATABASE_PATH=
DREAMCARD_KNOWLEDGE_INDEX_PATH=
DREAMCARD_CORS_ORIGINS=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_ACCESS_SECRET=
# Callback + stable identity field still use integrations/zhihu-login/hackathon.config.json.
# Do not guess identityPath or disable state verification to make authorization pass.
